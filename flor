<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flor 🌼</title>
  <style>
    body {
      margin: 0;
      background-color: black; /* Fondo negro */
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .flor {
      font-size: 100px;
      color: yellow; /* Color amarillo para la flor */
      animation: girar 4s infinite linear; /* Animación */
    }

    @keyframes girar {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }
  </style>
</head>
<body>
  <div class="flor">🌼</div>
</body>
</html>
